# ============================================================
# Cache-control — evita páginas presas em cache do navegador.
# HTML e PHP sempre revalidam (pega atualizações sem hard refresh).
# Assets versionados (?v=) podem ser cacheados normalmente.
# ============================================================
<IfModule mod_headers.c>
  <FilesMatch "\.(?:html|php)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>
